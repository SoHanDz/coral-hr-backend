# Copy file này thành ".env" rồi chỉnh lại nếu cần
# Cấu hình chuẩn cho MySQL chạy từ XAMPP (host localhost, port 3306, user root, không mật khẩu)
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=coral_hr
# Đặt true khi dùng MySQL cloud yêu cầu SSL (vd: Aiven)
DB_SSL=false

# Frontend chạy ở đâu (dùng để enableCors kèm credentials)
FRONTEND_URL=http://localhost:5173

# Khoá ký JWT - BẮT BUỘC đổi giá trị khi deploy thật, không dùng giá trị mặc định
JWT_ACCESS_SECRET=change-this-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
